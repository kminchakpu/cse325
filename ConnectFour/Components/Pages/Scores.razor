
@page "/scores"

@inject ConnectFour.GameState State

<PageTitle>Game Scores</PageTitle>

<h3>Game Scores</h3>

<p>Overall results from completed games.</p>

<div class="row g-3 mt-3">
    <div class="col-md-6 col-lg-3">
        <div class="card text-center p-3">
            <h5>Player 1 Wins</h5>
            <h2>@State.Player1Wins</h2>
        </div>
    </div>

    <div class="col-md-6 col-lg-3">
        <div class="card text-center p-3">
            <h5>Player 2 Wins</h5>
            <h2>@State.Player2Wins</h2>
        </div>
    </div>

    <div class="col-md-6 col-lg-3">
        <div class="card text-center p-3">
            <h5>Draws</h5>
            <h2>@State.Draws</h2>
        </div>
    </div>

    <div class="col-md-6 col-lg-3">
        <div class="card text-center p-3">
            <h5>Total Games</h5>
            <h2>@State.TotalGames</h2>
        </div>
    </div>
</div>
