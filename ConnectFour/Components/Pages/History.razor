
@page "/history"

@inject ConnectFour.GameState State

<PageTitle>Game History - ConnectFour</PageTitle>

<div class="history-page">

    <h2>Game History</h2>

    <p class="text-muted">
        View the results of your previously completed games.
    </p>

    @if (State.GameHistory.Count == 0)
    {
        <div class="alert alert-info mt-4">
            No games have been completed yet.
            Play a game to see your results here.
        </div>
    }
    else
    {
        <div class="card shadow-sm mt-4">

            <div class="card-header">
                <h5 class="mb-0">Completed Games</h5>
            </div>

            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">
                        <tr>
                            <th>Game</th>
                            <th>Result</th>
                            <th>Date</th>
                            <th>Time</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var game in State.GameHistory.Reverse())
                        {
                            <tr>
                                <td>#@game.GameNumber</td>

                                <td>
                                    @if (game.Result == "Player 1 Wins")
                                    {
                                        <span class="badge bg-success">
                                            @game.Result
                                        </span>
                                    }
                                    else if (game.Result == "Player 2 Wins")
                                    {
                                        <span class="badge bg-primary">
                                            @game.Result
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">
                                            @game.Result
                                        </span>
                                    }
                                </td>

                                <td>
                                    @game.CompletedAt.ToString("dd MMM yyyy")
                                </td>

                                <td>
                                    @game.CompletedAt.ToString("hh:mm tt")
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>
            </div>

        </div>

        <p class="text-muted mt-3">
            Total completed games: @State.GameHistory.Count
        </p>
    }

</div>

