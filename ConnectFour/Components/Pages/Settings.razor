
@page "/settings"
@rendermode InteractiveServer

@inject GameState State

<PageTitle>Game Settings - ConnectFour</PageTitle>

<div class="settings-page">

    <h2>Game Settings</h2>

    <p class="text-muted">
        Customize the appearance of your Connect Four game.
    </p>

    <div class="card shadow-sm mt-4">

        <div class="card-header">
            <h5 class="mb-0">Game Colours</h5>
        </div>

        <div class="card-body">

            <div class="mb-4">
                <label for="boardColor" class="form-label">
                    Board Background Colour
                </label>

                <div class="d-flex align-items-center gap-3">
                    <input id="boardColor"
                           type="color"
                           class="form-control form-control-color"
                           @bind="State.BoardColor"
                           @bind:event="oninput" />

                    <span>@State.BoardColor</span>
                </div>
            </div>

            <div class="mb-4">
                <label for="player1Color" class="form-label">
                    Player 1 Piece Colour
                </label>

                <div class="d-flex align-items-center gap-3">
                    <input id="player1Color"
                           type="color"
                           class="form-control form-control-color"
                           @bind="State.Player1Color"
                           @bind:event="oninput" />

                    <span>@State.Player1Color</span>
                </div>
            </div>

            <div class="mb-4">
                <label for="player2Color" class="form-label">
                    Player 2 Piece Colour
                </label>

                <div class="d-flex align-items-center gap-3">
                    <input id="player2Color"
                           type="color"
                           class="form-control form-control-color"
                           @bind="State.Player2Color"
                           @bind:event="oninput" />

                    <span>@State.Player2Color</span>
                </div>
            </div>

            <button class="btn btn-secondary"
                    @onclick="ResetColors">
                Restore Default Colours
            </button>

        </div>
    </div>

</div>

@code {
    private void ResetColors()
    {
        State.BoardColor = "#000000";
        State.Player1Color = "#008000";
        State.Player2Color = "#800080";
    }
}
