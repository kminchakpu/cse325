
@using System.Drawing
@using Microsoft.AspNetCore.Components.Web
@inject GameState State

<HeadContent>
    <style>
        :root {
            --board-bg: @ColorTranslator.ToHtml(BoardColor);
            --player1: @ColorTranslator.ToHtml(Player1Color);
            --player2: @ColorTranslator.ToHtml(Player2Color);
        }
    </style>
</HeadContent>

<div class="local-game"
     tabindex="0"
     role="group"
     aria-label="Connect Four game. Use the left and right arrow keys to select a column, then press Enter or Space to drop a piece."
     @onkeydown="HandleKeyDown">

    <div class="keyboard-instructions" aria-live="polite">
        <strong>Keyboard controls:</strong>
        Left/Right arrows to select a column.
        Enter or Space to drop a piece.
    </div>

    <nav class="game-column-controls"
         aria-label="Select a column">

        @for (byte i = 0; i < 7; i++)
        {
            var col = i;

            <button type="button"
                    class="column-button @(selectedColumn == col ? "selected-column" : "")"
                    title="Drop a piece in column @(col + 1)"
                    aria-label="Drop a piece in column @(col + 1)"
                    aria-pressed="@(selectedColumn == col)"
                    @onclick="() => PlayPiece(col)">
                🔽
            </button>
        }

    </nav>

    <article class="game-message-container">

        @if (!string.IsNullOrEmpty(winnerMessage))
        {
            <div class="winner-message" role="status" aria-live="assertive">
                @winnerMessage
            </div>
        }

        <button class="reset-game-button"
                style="@ResetStyle"
                @onclick="ResetGame">
            <i class="bi bi-arrow-clockwise"></i>
            Play Again
        </button>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="game-error-message" role="alert">
                @errorMessage
            </div>
        }

        @if (string.IsNullOrEmpty(winnerMessage))
        {
            <div class="current-turn-message" aria-live="polite">
                @CurrentTurn
            </div>
        }

    </article>

    <div class="game-container"
         role="img"
         aria-label="@BoardDescription">

        <div class="board">
            @for (var i = 0; i < 42; i++)
            {
                <span class="container">
                    <span></span>
                </span>
            }
        </div>

        @for (var i = 0; i < 42; i++)
        {
            <span class="@pieces[i]"></span>
        }

    </div>

</div>

@code {
    [Parameter]
    public Color BoardColor { get; set; } =
        ColorTranslator.FromHtml("yellow");

    [Parameter]
    public Color Player1Color { get; set; } =
        ColorTranslator.FromHtml("red");

    [Parameter]
    public Color Player2Color { get; set; } =
        ColorTranslator.FromHtml("blue");

    private string[] pieces = new string[42];

    private string winnerMessage = string.Empty;
    private string errorMessage = string.Empty;

    private int selectedColumn = 3;

    // Prevents the same game result from being recorded more than once.
    private bool resultRecorded = false;

    private string CurrentTurn =>
        winnerMessage == string.Empty
            ? $"Player {State.PlayerTurn}'s Turn"
            : string.Empty;

    private string ResetStyle =>
        winnerMessage == string.Empty
            ? "display: none;"
            : string.Empty;

    private string BoardDescription =>
        $"Connect Four board. Player {State.PlayerTurn}'s turn. {pieces.Count(p => !string.IsNullOrEmpty(p))} pieces have been played.";

    protected override void OnInitialized()
    {
        State.ResetBoard();
    }

    private void HandleKeyDown(KeyboardEventArgs e)
    {
        if (!string.IsNullOrEmpty(winnerMessage))
        {
            return;
        }

        switch (e.Key)
        {
            case "ArrowLeft":
                selectedColumn = Math.Max(0, selectedColumn - 1);
                break;

            case "ArrowRight":
                selectedColumn = Math.Min(6, selectedColumn + 1);
                break;

            case "Enter":
            case " ":
            case "Spacebar":
                PlayPiece((byte)selectedColumn);
                break;
        }
    }

    private void PlayPiece(byte col)
    {
        if (!string.IsNullOrEmpty(winnerMessage))
        {
            return;
        }

        errorMessage = string.Empty;
        selectedColumn = col;

        try
        {
            var player = State.PlayerTurn;
            var turn = State.CurrentTurn;

            var landingRow = State.PlayPiece(col);

            pieces[turn] = $"player{player} col{col} drop{landingRow}";

            var result = State.CheckForWin();

            winnerMessage = result switch
            {
                GameState.WinState.Player1_Wins => "Player 1 Wins!",
                GameState.WinState.Player2_Wins => "Player 2 Wins!",
                GameState.WinState.Tie => "It's a tie!",
                _ => string.Empty
            };

            // Record the completed game result exactly once.
            if (result != GameState.WinState.No_Winner && !resultRecorded)
            {
                State.RecordResult(result);
                resultRecorded = true;
            }
        }
        catch (ArgumentException ex)
        {
            errorMessage = ex.Message;
        }
    }

    private void ResetGame()
    {
        State.ResetBoard();

        winnerMessage = string.Empty;
        errorMessage = string.Empty;

        pieces = new string[42];

        selectedColumn = 3;

        // Allow the next game to have its result recorded.
        resultRecorded = false;
    }
}
